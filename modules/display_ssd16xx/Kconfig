# Out-of-tree SSD16XX display driver vendored into eno-os.
#
# The in-tree Zephyr driver (CONFIG_SSD16XX) relies on an undocumented
# buffer swap after gen2 (SSD168x) partial refreshes, which does not
# work reliably. This vendored copy maintains both RAM buffers
# explicitly instead. Disable CONFIG_SSD16XX in prj.conf when using
# this driver.

config SSD16XX_EPD
	bool "SSD16XX EPD display driver (vendored, gen2 partial refresh fix)"
	default y
	depends on !SSD16XX
	depends on \
		DT_HAS_SOLOMON_SSD1608_ENABLED || \
		DT_HAS_SOLOMON_SSD1673_ENABLED || \
		DT_HAS_SOLOMON_SSD1675A_ENABLED || \
		DT_HAS_SOLOMON_SSD1680_ENABLED || \
		DT_HAS_SOLOMON_SSD1681_ENABLED
	select MIPI_DBI
	help
	  Vendored SSD16XX compatible controller driver with proper
	  partial refresh handling for gen2 (SSD168x) controllers.
